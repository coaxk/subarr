# Frontend build tooling — Node deps only, never committed.
# The compiled *.bundle.js + *.bundle.js.map ARE committed (under
# src/subarr/static/v1/home-hifi/) so `pip install` ships a working
# SPA without a Node toolchain on consumer machines.
node_modules/
.tmp-*

# brainstorming visual companion artifacts
.superpowers/

# Caliber local state (tool-managed, never source-controlled)
.caliber/

# Claude Code local state (tool-managed). Currently just tdd-guard's
# scratch JSON. NOTE this ignores the whole directory, so if project-level
# Claude config is ever meant to be SHARED (.claude/settings.json, agents,
# skills, hooks), it needs an explicit negation here or it will be dropped
# silently -- the same way this repo family has lost requirements.txt,
# *.sh, *.psm1 and *.vbs to ignore rules before.
.claude/

# Local scratch: aftercare/regroup tuning baselines (#168 comparison snapshots)
.aftercare-baseline-*.json

# Phase 2 study (#171): regenerable media, never commit.
# clips/ is 3.3 GB of extracted video and audio/ 269 MB of derived wav -- both
# rebuild from the library via scripts/phase2_corpus.py plus the manifest.
# out/ IS committed: the SRTs are the study's evidence and are small.
study/clips/
study/audio/

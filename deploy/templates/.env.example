# Subarr deployment .env example
# Copy to .env and fill in. Comments mark which tiers each variable
# matters for.

# ───────────────────────────────────────────────────────────────────
# Universal (all tiers)
# ───────────────────────────────────────────────────────────────────
TZ=Australia/Sydney
PUID=1000
PGID=1000

# Absolute host path to your media library. Mounted read-only into
# subarr at /media/library and into subgen at /media.
MEDIA_ROOT=/mnt/nas/Media

# ───────────────────────────────────────────────────────────────────
# Tier 1 only — manual integration config
# ───────────────────────────────────────────────────────────────────
# These are blank for Tier 2/3 (the wizard fills them in). For Tier 1
# they're how subarr knows how to reach your *arr stack.
#
# URLs use container names when subarr shares a network with the
# target; use http://<host-ip>:<port> or http://host.docker.internal:<port>
# otherwise.
BAZARR_URL=
BAZARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=
RADARR_URL=
RADARR_API_KEY=
TAUTULLI_URL=
TAUTULLI_API_KEY=

# ───────────────────────────────────────────────────────────────────
# Tier 3 only — host paths to *arr config dirs for API-key auto-extract
# ───────────────────────────────────────────────────────────────────
# Subarr reads these read-only. Comment out any you'd rather paste
# manually. Defaults assume a colocated stack layout.
BAZARR_CONFIG=
SONARR_CONFIG=
RADARR_CONFIG=
TAUTULLI_CONFIG=
